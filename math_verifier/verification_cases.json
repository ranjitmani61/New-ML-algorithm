            "domain": "real"
          },
          "y": {
            "domain": "real"
          }
        },
        "lhs": "(x+y)**2",
        "op": "==",
        "rhs": "x**2+2*x*y+y**2"
      },
      "expected": "VERIFIED",
      "reason": "The binomial identity holds for every real x and y by distributivity."
    },
